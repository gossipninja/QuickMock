<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="3">

        <Button android:id="@+id/btn_loc_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />
        <Button android:id="@+id/btn_loc_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />
        <Button android:id="@+id/btn_loc_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />

        <Button android:id="@+id/btn_loc_4" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />
        <Button android:id="@+id/btn_loc_5" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />
        <Button android:id="@+id/btn_loc_6" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />

        <Button android:id="@+id/btn_loc_7" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />
        <Button android:id="@+id/btn_loc_8" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />
        <Button android:id="@+id/btn_loc_9" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="2dp" android:background="@drawable/widget_button_bg" android:textColor="#FFFFFF" android:textSize="10sp" />

    </GridLayout>

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_button_bg"
        android:text="Stop Mocking"
        android:textColor="#FF453A"
        android:textSize="11sp" />

</LinearLayout>