<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    android:orientation="vertical"
    android:padding="8dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="3">

        <Button android:id="@+id/btn_slot_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_4" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_5" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_6" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_7" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_8" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
        <Button android:id="@+id/btn_slot_9" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="2dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:textSize="11sp" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_toggle_mock"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:layout_marginEnd="2dp"
            android:text="▶"
            android:textSize="16sp"
            android:tooltipText="Start/Stop Mocking" />

        <Button
            android:id="@+id/btn_find_location"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="🔍"
            android:textSize="16sp"
            android:tooltipText="Find &amp; Set Mock Location" />
    </LinearLayout>
</LinearLayout>