<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QuickMock Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Location 1 -->
        <EditText android:id="@+id/et_name_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Preset 1 Name" />
        <EditText android:id="@+id/et_lat_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Latitude 1" android:inputType="numberSigned|numberDecimal" />
        <EditText android:id="@+id/et_lng_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Longitude 1" android:inputType="numberSigned|numberDecimal" />

        <!-- Location 2 -->
        <EditText android:id="@+id/et_name_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Preset 2 Name" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/et_lat_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Latitude 2" android:inputType="numberSigned|numberDecimal" />
        <EditText android:id="@+id/et_lng_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Longitude 2" android:inputType="numberSigned|numberDecimal" />

        <!-- Location 3 -->
        <EditText android:id="@+id/et_name_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Preset 3 Name" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/et_lat_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Latitude 3" android:inputType="numberSigned|numberDecimal" />
        <EditText android:id="@+id/et_lng_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Longitude 3" android:inputType="numberSigned|numberDecimal" />

        <!-- Location 4 -->
        <EditText android:id="@+id/et_name_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Preset 4 Name" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/et_lat_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Latitude 4" android:inputType="numberSigned|numberDecimal" />
        <EditText android:id="@+id/et_lng_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Longitude 4" android:inputType="numberSigned|numberDecimal" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Update Widget"
            android:layout_marginTop="20dp" />

        <!-- Credits Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Credits"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QuickMock v1.0\nCreated by gossipninja\nBuilt with Kotlin &amp; AndroidX"
            android:layout_marginTop="8dp"
            android:textColor="#888888" />

    </LinearLayout>
</ScrollView>